  "title": "Scientific Notation & Monomials",
  "rule_line": true,
  "reminder": [
    "\\text{Scientific: }a \\times 10^{n}\\text{, }1 ≤ a < 10",
    "\\text{Number ≥ 10: positive exponent}",
    "\\text{Number < 1: negative exponent}",
    "a^{m} \\cdot a^{n} = a^{m+n}",
    "\\frac{a^{m}}{a^{n}} = a^{m-n}",
    "\\text{Multiply: } \\times \\text{ numbers, + exponents}",
    "\\text{Divide: } ÷ \\text{ numbers, − exponents}"
  ],
  "example": {
    "label": "Example: multiply in scientific notation",
    "steps": [
      "(6 \\times 10^{-3})(4 \\times 10^{7})",
      "= (6 \\cdot 4) \\times 10^{-3+7}",
      "= 24 \\times 10^{4}",
      "= 2.4 \\times 10^{5}",
      "\\text{Rule: multiply numbers, add exponents.}",
      "\\text{24 ≥ 10, so move the decimal.}"
    ]
  },
