{
  "date": "2026-11-05",
  "title": "Dividing Scientific Notation & Monomials",
  "rule_line": true,
  "reminder": [
    "a^{-n} = \\frac{1}{a^{n}}",
    "a^{m} \\cdot a^{n} = a^{m+n}",
    "\\frac{a^{m}}{a^{n}} = a^{m-n}",
    "(a^{m})^{n} = a^{mn}",
    "\\text{Scientific: }a \\times 10^{n}\\text{, }1 ≤ a < 10",
    "\\text{Multiply: } \\times \\text{ numbers, + exponents}",
    "\\text{Divide: } ÷ \\text{ numbers, − exponents}"
  ],
  "example": {
    "label": "Example: divide in scientific notation",
    "steps": [
      "\\frac{1.5 \\times 10^{6}}{3 \\times 10^{-2}}",
      "= (1.5 ÷ 3) \\times 10^{6-(-2)}",
      "= 0.5 \\times 10^{8}",
      "= 5 \\times 10^{7}",
      "\\text{Rule: divide numbers, subtract exponents.}",
      "\\text{0.5 < 1, so move the decimal right, subtract 1.}"
    ]
  },
