{
  "date": "2026-10-27",
  "title": "Negative Exponents & Scientific Notation",
  "reminder": [
    "a^{-n} = \\frac{1}{a^{n}}",
    "\\frac{1}{a^{-n}} = a^{n}",
    "a^{m} \\cdot a^{n} = a^{m+n}",
    "\\frac{a^{m}}{a^{n}} = a^{m-n}",
    "(a^{m})^{n} = a^{mn}",
    "\\text{Scientific notation: }a \\times 10^{n}",
    "\\text{where }1 \u2264 a < 10"
  ],
  "example": {
    "label": "Example: scientific notation",
    "steps": [
      "\\text{To scientific: }0.00052 = 5.2 \\times 10^{-4}",
      "\\text{(decimal moved 4 places right, so exponent is }-4\\text{)}",
      "\\text{From scientific: }3.1 \\times 10^{5} = 310,000",
      "\\text{(exponent is 5, so move decimal 5 places right)}",
      "\\text{Number \u2265 10: positive exponent. Number < 1: negative.}"
    ]
  },
  "sections": [
    {
      "directions": "Rewrite using only positive exponents.",
      "questions": [
        {"n": 1, "skill": "neg-to-pos", "expr": "9^{-3}", "answer": "\\frac{1}{9^{3}}"},
        {"n": 2, "skill": "neg-to-pos", "expr": "5x^{-2}y^{3}", "answer": "\\frac{5y^{3}}{x^{2}}", "note": "5 and y stay on top"}
      ]
    },
    {
      "directions": "Rewrite using a negative exponent.",
      "questions": [
        {"n": 3, "skill": "pos-to-neg", "expr": "\\frac{1}{8^{5}}", "answer": "8^{-5}"},
        {"n": 4, "skill": "pos-to-neg", "expr": "\\frac{3}{x^{4}}", "answer": "3x^{-4}", "note": "3 stays as is"}
      ]
    },
    {
      "directions": "Evaluate. Write your answer as a whole number or a fraction.",
      "questions": [
        {"n": 5, "skill": "eval-neg", "expr": "4^{-2}", "answer": "\\frac{1}{16}"},
        {"n": 6, "skill": "eval-neg", "expr": "(-2)^{-3}", "answer": "-\\frac{1}{8}", "note": "odd power of negative base stays negative"}
      ]
    },
    {
      "directions": "Simplify. Write your answer using only positive exponents.",
      "questions": [
        {"n": 7, "skill": "simplify-product", "expr": "y^{-4} \\cdot y^{9}", "answer": "y^{5}"},
        {"n": 8, "skill": "simplify-product", "expr": "3^{4} \\cdot 3^{-7}", "answer": "\\frac{1}{3^{3}}", "note": "1/27 also correct"},
        {"n": 9, "skill": "simplify-quotient", "expr": "\\frac{a^{-5}}{a^{2}}", "answer": "\\frac{1}{a^{7}}"},
        {"n": 10, "skill": "simplify-quotient", "expr": "\\frac{x^{-1}}{x^{-6}}", "answer": "x^{5}"},
        {"n": 11, "skill": "simplify-power", "expr": "(y^{4})^{-2}", "answer": "\\frac{1}{y^{8}}"},
        {"n": 12, "skill": "simplify-power", "expr": "(2^{-3})^{-1}", "answer": "2^{3}", "note": "8 also correct"}
      ]
    },
    {
      "directions": "Write in scientific notation.",
      "questions": [
        {"n": 13, "skill": "to-sci", "expr": "45,000", "answer": "4.5 \\times 10^{4}"},
        {"n": 14, "skill": "to-sci", "expr": "6,030,000", "answer": "6.03 \\times 10^{6}"},
        {"n": 15, "skill": "to-sci", "expr": "0.0072", "answer": "7.2 \\times 10^{-3}"},
        {"n": 16, "skill": "to-sci", "expr": "0.000108", "answer": "1.08 \\times 10^{-4}"}
      ]
    },
    {
      "directions": "Write in standard form.",
      "questions": [
        {"n": 17, "skill": "from-sci", "expr": "3.2 \\times 10^{5}", "answer": "320,000"},
        {"n": 18, "skill": "from-sci", "expr": "7.01 \\times 10^{3}", "answer": "7,010"},
        {"n": 19, "skill": "from-sci", "expr": "4 \\times 10^{-3}", "answer": "0.004"},
        {"n": 20, "skill": "from-sci", "expr": "5.6 \\times 10^{-5}", "answer": "0.000056"}
      ]
    }
  ]
}
