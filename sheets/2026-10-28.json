{
  "date": "2026-10-28",
  "title": "Scientific Notation & Multiplying Monomials",
  "rule_line": true,
  "reminder": [
    "\\text{Scientific: }a \\times 10^{n}\\text{, }1 ≤ a < 10",
    "\\text{Number ≥ 10: positive exponent}",
    "\\text{Number < 1: negative exponent}",
    "a^{m} \\cdot a^{n} = a^{m+n}",
    "\\text{Multiplying: multiply the numbers,}",
    "\\text{then add the exponents}"
  ],
  "example": {
    "label": "Example: multiply in scientific notation",
    "steps": [
      "(4 \\times 10^{5})(3 \\times 10^{-2})",
      "= (4 \\cdot 3) \\times 10^{5+(-2)}",
      "= 12 \\times 10^{3}",
      "= 1.2 \\times 10^{4}",
      "\\text{Rule: multiply numbers, add exponents.}",
      "\\text{12 is not less than 10, so move the decimal.}"
    ]
  },
