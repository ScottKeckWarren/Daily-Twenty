{
  "date": "2026-11-16",
  "title": "Mixed Review: Exponents & Scientific Notation",
  "rule_line": true,
  "reminder": [
    "a^{-n} = \\frac{1}{a^{n}}",
    "\\frac{1}{a^{-n}} = a^{n}",
    "a^{m} \\cdot a^{n} = a^{m+n}",
    "\\frac{a^{m}}{a^{n}} = a^{m-n}",
    "(a^{m})^{n} = a^{mn}",
    "\\text{Scientific: }a \\times 10^{n}\\text{, }1 ≤ a < 10",
    "\\text{Multiply: } \\times \\text{ numbers, + exponents}",
    "\\text{Divide: } ÷ \\text{ numbers, − exponents}"
  ],
  "example": {
    "label": "Example: multiply in scientific notation",
    "steps": [
      "(5 \\times 10^{-3})(4 \\times 10^{7})",
      "= (5 \\times 4) \\times 10^{-3+7}",
      "= 20 \\times 10^{4}",
      "= 2 \\times 10^{5}",
      "\\text{Rule: multiply numbers, add exponents.}",
      "\\text{20 ≥ 10, so move the decimal left, add 1.}"
    ]
  },
  "sections": [
    {
      "directions": "Rewrite using only positive exponents.",
      "questions": [
        {
          "n": 1,
          "skill": "neg-to-pos",
          "expr": "3^{-5}",
          "answer": "\\frac{1}{3^{5}}",
          "rule": "negative exponent: flip to the denominator"
        },
        {
          "n": 2,
          "skill": "neg-to-pos",
          "expr": "9w^{-2}",
          "answer": "\\frac{9}{w^{2}}",
          "rule": "only w flips; the 9 stays on top"
        }
      ]
    },
    {
      "directions": "Rewrite using a negative exponent.",
      "questions": [
        {
          "n": 3,
          "skill": "pos-to-neg",
          "expr": "\\frac{1}{7^{3}}",
          "answer": "7^{-3}",
          "rule": "move out of the denominator, make the exponent negative"
        },
        {
          "n": 4,
          "skill": "pos-to-neg",
          "expr": "\\frac{1}{q^{6}}",
          "answer": "q^{-6}",
          "rule": "move out of the denominator, make the exponent negative"
        }
      ]
    },
    {
      "directions": "Evaluate. Write your answer as a whole number or a fraction.",
      "questions": [
        {
          "n": 5,
          "skill": "eval-neg",
          "expr": "2^{-5}",
          "answer": "\\frac{1}{32}",
          "rule": "flip, then evaluate 2^5"
        },
        {
          "n": 6,
          "skill": "eval-neg",
          "expr": "\\frac{1}{3^{-4}}",
          "answer": "81",
          "rule": "flip to the numerator, then evaluate 3^4"
        },
        {
          "n": 7,
          "skill": "eval-neg",
          "expr": "(-4)^{-2}",
          "answer": "\\frac{1}{16}",
          "rule": "flip, then evaluate (-4)^2",
          "note": "even power of a negative is positive"
        }
      ]
    },
    {
      "directions": "Simplify. Write your answer using only positive exponents.",
      "questions": [
        {
          "n": 8,
          "skill": "simplify-product",
          "expr": "d^{-6} \\cdot d^{2}",
          "answer": "\\frac{1}{d^{4}}",
          "rule": "add exponents"
        },
        {
          "n": 9,
          "skill": "simplify-quotient",
          "expr": "\\frac{5^{3}}{5^{-2}}",
          "answer": "5^{5}",
          "rule": "subtract exponents",
          "note": "3 - (-2) = 5"
        },
        {
          "n": 10,
          "skill": "simplify-power",
          "expr": "(g^{-5})^{-2}",
          "answer": "g^{10}",
          "rule": "multiply exponents",
          "note": "negative times negative is positive"
        }
      ]
    },
    {
      "directions": "Write in scientific notation.",
      "questions": [
        {
          "n": 11,
          "skill": "to-sci",
          "expr": "0.00062",
          "answer": "6.2 \\times 10^{-4}",
          "rule": "number < 1: negative exponent"
        },
        {
          "n": 12,
          "skill": "to-sci",
          "expr": "38,100,000",
          "answer": "3.81 \\times 10^{7}",
          "rule": "number ≥ 10: positive exponent"
        }
      ]
    },
    {
      "directions": "Write in standard form.",
      "questions": [
        {
          "n": 13,
          "skill": "from-sci",
          "expr": "5.03 \\times 10^{6}",
          "answer": "5,030,000",
          "rule": "positive exponent: move decimal right"
        },
        {
          "n": 14,
          "skill": "from-sci",
          "expr": "2.4 \\times 10^{-6}",
          "answer": "0.0000024",
          "rule": "negative exponent: move decimal left"
        }
      ]
    },
    {
      "directions": "Multiply or divide. Simplify your answer.",
      "questions": [
        {
          "n": 15,
          "skill": "monomials",
          "expr": "-3j^{5} \\cdot 6j^{2}",
          "answer": "-18j^{7}",
          "rule": "multiply numbers, add exponents"
        },
        {
          "n": 16,
          "skill": "monomials",
          "expr": "-2c^{3} \\cdot (-11c^{4})",
          "answer": "22c^{7}",
          "rule": "multiply numbers, add exponents",
          "note": "negative times negative is positive"
        },
        {
          "n": 17,
          "skill": "monomials",
          "expr": "\\frac{36z^{8}}{-4z^{2}}",
          "answer": "-9z^{6}",
          "rule": "divide numbers, subtract exponents"
        }
      ]
    },
    {
      "directions": "Multiply. Write your answer in scientific notation.",
      "questions": [
        {
          "n": 18,
          "skill": "sci-multiply",
          "expr": "(3 \\times 10^{-4})(2 \\times 10^{9})",
          "answer": "6 \\times 10^{5}",
          "rule": "multiply numbers, add exponents"
        },
        {
          "n": 19,
          "skill": "sci-multiply",
          "expr": "(4 \\times 10^{3})(9 \\times 10^{-8})",
          "answer": "3.6 \\times 10^{-4}",
          "rule": "multiply numbers, add exponents; 36 ≥ 10 so re-normalize",
          "note": "36 x 10^-5 -> 3.6 x 10^-4"
        }
      ]
    },
    {
      "directions": "Divide. Write your answer in scientific notation.",
      "questions": [
        {
          "n": 20,
          "skill": "sci-divide",
          "expr": "\\frac{8.4 \\times 10^{7}}{2.1 \\times 10^{3}}",
          "answer": "4 \\times 10^{4}",
          "rule": "divide numbers, subtract exponents"
        },
        {
          "n": 21,
          "skill": "sci-divide",
          "expr": "\\frac{1.4 \\times 10^{-5}}{7 \\times 10^{2}}",
          "answer": "2 \\times 10^{-8}",
          "rule": "divide numbers, subtract exponents; less than 1 so re-normalize",
          "note": "0.2 x 10^-7 -> 2 x 10^-8"
        }
      ]
    }
  ]
}
